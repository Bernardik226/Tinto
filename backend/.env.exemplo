# Copie para `.env` (local) ou cadastre como variáveis de ambiente na sua
# hospedagem. O `.env` NUNCA entra no repositório.

# ── Google ───────────────────────────────────────────────────────────
# Google Cloud Console → APIs e Serviços → Credenciais → ID do cliente
# OAuth 2.0, tipo "Aplicativo da Web". Ative a Calendar API e a Tasks API,
# e publique a tela de consentimento como "In Production".
#
# O redirect precisa bater EXATAMENTE com o cadastrado no console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=https://SEU-SERVIDOR/oauth/retorno

# ── quem pode usar este servidor ─────────────────────────────────────
# Os e-mails Google que podem entrar, separados por vírgula, cada um com o
# seu limite de voz por mês em minutos (opcional):
#
#     TINTO_CONTAS=voce@gmail.com:120,mae@gmail.com:30,pai@gmail.com
#
# Sem número, vale QUOTA_PADRAO_S. VAZIA = NINGUÉM ENTRA: as chaves de IA
# abaixo são suas, e quem achar o endereço do servidor não pode usá-las.
# Cada pessoa pode vincular quantos Tintos quiser; eles dividem a cota.
TINTO_CONTAS=voce@gmail.com

# O limite padrão de voz por mês, em segundos (1800 = 30 minutos).
QUOTA_PADRAO_S=1800

# ── as IAs ───────────────────────────────────────────────────────────
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ── o estado ─────────────────────────────────────────────────────────
# Um arquivo JSON com aparelhos, contas, refresh tokens e sessões. Em
# produção, aponte para dentro de um VOLUME persistente: sem volume, o
# container reinicia e os vínculos somem. Sem a variável, o servidor roda
# só em memória.
TINTO_ESTADO=estado.json

# ── opcional: aviso instantâneo do Calendar ──────────────────────────
# Sem isto, o servidor consulta o Calendar periodicamente. Com isto, o
# Google avisa na hora — exige domínio verificado no Search Console.
# TINTO_WEBHOOK_URL=https://SEU-SERVIDOR/v1/google/aviso
# TINTO_WEBHOOK_SEGREDO=
# GOOGLE_SITE_VERIFICATION=

# ── só para desenvolvimento local ────────────────────────────────────
# Pasta de onde o simulador pode mandar áudio por nome de arquivo.
# Deixe VAZIA em produção.
TINTO_AUDIO_RAIZ=
